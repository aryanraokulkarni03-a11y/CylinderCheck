# ============================================================
# CylinderCheck - Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ============================================================

# --- PostHog Analytics ------------------------------------------
# Get these from PostHog Project Settings -> Web snippet
VITE_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxx
VITE_POSTHOG_HOST=https://us.i.posthog.com

# --- Supabase ---------------------------------------------------
# Get these from: supabase.com -> your project -> Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- Razorpay ---------------------------------------------------
# Get these from: razorpay.com -> Settings -> API Keys
# Only the KEY_ID is used client-side (safe to expose)
# KEY_SECRET lives only in Supabase Edge Function secrets (never here)
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx

# --- Admin panel ------------------------------------------------
# Password for the hidden admin dashboard (5x logo click)
# Use a strong random string - this is your only gate
# NOTE: This must be set securely in Supabase -> Edge Functions -> Secrets -> ADMIN_PASSWORD
# Do NOT store VITE_ADMIN_PASSWORD in the frontend!

# ============================================================
# Supabase Edge Function secrets (set in Supabase dashboard,
# NOT in this file - these never touch the frontend):
#   RAZORPAY_KEY_SECRET   -> your Razorpay secret key
#   ADMIN_PASSWORD        -> password for the frontend admin panel
#   RESEND_API_KEY        -> used by sign-in mail and free reminder emails
#   RESEND_FROM_EMAIL     -> sender identity for emails
#   SUPPORT_REPLY_TO      -> reply-to inbox for user replies
#   CRON_SECRET           -> random string, used to auth scrape-prices cron job
#                           generate one: openssl rand -hex 32
# ============================================================
